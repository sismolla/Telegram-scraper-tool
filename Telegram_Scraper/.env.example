# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+1234567890

# Generated by 01-Telegram Session Generator.py (keep secret!)
TELEGRAM_SESSION_STRING=

# Scraper Settings
# Target channel or group username or full link (e.g., 't.me/example' or 'example')
TARGET_CHAT=your_channel_or_group

# Set DOWNLOAD_MEDIA to True if you want to download photos/videos (False for faster, safer metadata-only)
DOWNLOAD_MEDIA=False

# Start date to scrape backwards from in UTC (format: YYYY-MM-DD or leave empty for latest messages)
SCRAPE_START_DATE=
